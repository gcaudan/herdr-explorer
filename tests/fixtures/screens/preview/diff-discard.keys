# D: asks before discarding the hunk from the working tree.
size 80 16
file a.txt one\nthree\nfour\nfive\nsix\n
git init -q -b main
git add a.txt
git commit -q -m first
file a.txt one\ntwo\nthree\nfive\nsix!\n
state settings.json {"glyphs":"unicode","theme":"dark","updateCheck":false}
env EXPLORER_FILE=$ROOT/work/a.txt
env EXPLORER_ROOT=$ROOT/work
env EXPLORER_TAB=t1
start
keys d
wait 800
keys D
until 1500
