# A commit shown over the tabs, asked by source control at start (EXPLORER_SHOW).
size 80 20
file a.txt one\nthree\n
git init -q -b main
git add a.txt
git commit -q -m first
file a.txt one\ntwo\nthree\n
file b.txt bee\n
git add .
git commit -q -m second
state settings.json {"glyphs":"unicode","theme":"dark","updateCheck":false}
env EXPLORER_FILE=$ROOT/work/a.txt
env EXPLORER_ROOT=$ROOT/work
env EXPLORER_TAB=t1
env EXPLORER_SHOW={"kind":"commit","ref":"HEAD","cwd":"$ROOT/work","title":"second"}
start
until 1500
