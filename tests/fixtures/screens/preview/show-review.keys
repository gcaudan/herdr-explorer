# Beside a review: q says close, and the keys outside a commit's do nothing.
size 80 12
file a.txt one\nthree\n
git init -q -b main
git add a.txt
git commit -q -m first
file a.txt one\ntwo\nthree\n
file b.txt bee\n
git add .
git commit -q -m second
state settings.json {"glyphs":"unicode","theme":"dark","updateCheck":false}
env EXPLORER_FILE=$ROOT/work/a.txt
env EXPLORER_ROOT=$ROOT/work
env EXPLORER_TAB=t1
env EXPLORER_REVIEW=1
env EXPLORER_SHOW={"kind":"commit","ref":"HEAD~1","cwd":"$ROOT/work","title":"first"}
start
wait 800
keys d e
until 1500
