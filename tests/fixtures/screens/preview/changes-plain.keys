# Without line numbers, a column of its own for the changes; c turns them off then on.
size 60 12
file a.txt line 1\nline 2\nline 3\nline 4\nline 5\nline 6\nline 7\nline 8\nline 9\nline 10\nline 11\nline 12\nline 13\nline 14\nline 15\nline 16\nline 17\nline 18\nline 19\nline 20\nline 21\nline 22\nline 23\nline 24\nline 25\nline 26\nline 27\nline 28\nline 29\nline 30\n
git init -q -b main
git add a.txt
git commit -q -m first
file a.txt line 1\nline 2\nline 3\nline 4\nline five\nline 6\nline 7\nline 8\nline 9\nline 10\nline 11\nline 13\nline 14\nline 15\nline 16\nline 17\nline 18\nline 19\nline 20\nnew\nline 21\nline 22\nline 23\nline 24\nline 25\nline 26\nline 27\nline 28\nline 29\nline 30\n
state settings.json {"glyphs":"unicode","theme":"dark","updateCheck":false,"changes":true,"lineNumbers":false}
env EXPLORER_FILE=$ROOT/work/a.txt
start
wait 800
keys c
wait 300
keys c
until 1500
