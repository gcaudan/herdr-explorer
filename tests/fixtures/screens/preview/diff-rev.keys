# Compare with a commit typed in the footer (Commit or range…).
size 80 14
file a.txt one\nthree\nfour\n
git init -q -b main
git add a.txt
git commit -q -m first
file a.txt one\nthree\nfour\nfive\n
git commit -q -am second
file a.txt one\nthree\nfour\nfive\nsix\n
state settings.json {"glyphs":"unicode","theme":"dark","updateCheck":false}
env EXPLORER_FILE=$ROOT/work/a.txt
env EXPLORER_ROOT=$ROOT/work
env EXPLORER_TAB=t1
start
keys d
wait 800
keys b
keys down down down enter
text HEAD~1
keys enter
until 2000
