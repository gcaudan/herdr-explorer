# Without wrap, l and h move the text by 8 columns.
size 40 16
file a.txt one\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\neleven\ntwelve\n
file b.txt alpha\nbeta\n
git init -q -b main
git add a.txt b.txt
git commit -q -m first
file a.txt one\ntwo\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\neleven! and a long line that goes past the edge of the pane\ntwelve\n
file b.txt alpha\nbeta\ngamma\n
file c.txt new file\n
state settings.json {"glyphs":"unicode","theme":"dark","updateCheck":false}
herdr pane get {"result":{"pane":{"pane_id":"w1:p2","tab_id":"t1","workspace_id":"w1"}}}
env EXPLORER_ROOT=$ROOT/work
start
wait 800
keys l l
wait 200
keys h
until 1500
