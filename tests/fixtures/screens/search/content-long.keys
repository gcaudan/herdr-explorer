# Search in files: a minified line cut around its match, tabs and control characters in lines.
size 80 12
file min.js \n
file t.txt \t\tlead NEEDLE\x01tail\n
file w.txt word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word NEEDLE end\n
state settings.json {"glyphs":"unicode","theme":"dark","updateCheck":false}
start
keys ctrl+f
text NEEDLE
wait 400
