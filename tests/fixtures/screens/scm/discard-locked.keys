# d on Changes when git restore fails (index.lock): the untracked file stays, not trashed alone.
size 120 20
file a.txt one\n
git init -q -b main
git add a.txt
git commit -q -m first
file a.txt one\ntwo\n
file new.txt new\n
file .git/index.lock 
state settings.json {"glyphs":"unicode","theme":"dark","updateCheck":false}
herdr pane get {"result":{"pane":{"pane_id":"w1:p2","tab_id":"t1","workspace_id":"w1"}}}
start
wait 800
keys d y
wait 1500
